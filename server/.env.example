# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/valerius

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173

# JWT — generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Seed administrator
ADMIN_SEED_EMAIL=admin@valerius.example
ADMIN_SEED_PASSWORD=valerius-admin

# Cloudinary (media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_PUBLIC_KEY=

# Email (order confirmations, status updates)
EMAIL_FROM=VALERIUS <orders@valerius.example>
EMAIL_SMTP_URL=
